{
  "name": "secondsource",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "pnpm --filter @secondsource/api migrate",
    "db:seed": "pnpm --filter @secondsource/api seed",
    "db:seed:cala": "pnpm --filter @secondsource/api seed:cala",
    "dev:real": "node scripts/dev.mjs --real",
    "db:reset": "pnpm --filter @secondsource/api reset",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter @secondsource/web build",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
