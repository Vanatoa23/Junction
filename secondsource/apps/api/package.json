{
  "name": "@secondsource/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/seed.ts",
    "seed:cala": "tsx --env-file-if-exists=../../.env src/seed/cala.ts",
    "reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.1",
    "@secondsource/checks": "workspace:*",
    "@secondsource/shared": "workspace:*",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
