# Copy to .env. Never commit .env. The app runs with NO keys (SEED + REC only).

# --- Database ---------------------------------------------------------------
# Local default (docker compose or the bundled local-cluster fallback, see README).
DATABASE_URL=postgres://secondsource:secondsource@localhost:5434/secondsource
# Aiven later: only these two change. Example:
#   DATABASE_URL=postgres://avnadmin:<pw>@<host>.aivencloud.com:<port>/defaultdb?sslmode=require
#   DATABASE_SSL=require
DATABASE_SSL=disable

# --- API --------------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
# Public URL where Context.dev can reach us (tunnel locally, Aiven Runtime later).
# Also the URL of the TEST notice page the monitor watches: ${PUBLIC_BASE_URL}/test-notice
PUBLIC_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# --- Demo tenancy -----------------------------------------------------------
# No login in the MVP; every request acts as this client. Seeded by `pnpm db:seed`.
DEMO_CLIENT_ID=00000000-0000-4000-8000-000000000001

# --- source() adapter -------------------------------------------------------
# auto  = LIVE when a key is present, else REC fixture, else SEED
# rec   = never go live (REC fixture, else SEED)
# seed  = SEED only
SOURCE_MODE=auto
# 1 = write every successful LIVE response to apps/api/fixtures/rec (becomes REC later)
SOURCE_RECORD=0
SOURCE_TIMEOUT_MS=8000

# --- Provider keys (all optional) ------------------------------------------
CONTEXT_DEV_API_KEY=
# Webhook secrets (whsec_...) are per-monitor and returned at monitor creation; this is only for the shared-secret fallback
CONTEXT_DEV_WEBHOOK_SECRET=
EXA_API_KEY=
CALA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Worker -----------------------------------------------------------------
WORKER_POLL_MS=1000
